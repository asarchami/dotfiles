-- Monitor configuration.
-- Managed by chezmoi with a different layout per machine.

{{- if eq .chezmoi.hostname "cachyos-desktop" }}

-- PC configuration with three monitors: DP-3, DP-1 and DP-2.
hl.monitor({ output = "DP-3", mode = "3840x2160@144.0", position = "3840x452", scale = 1.0 })
hl.monitor({ output = "DP-1", mode = "2560x1440@59.95", position = "7680x215", scale = 1.0, transform = 3 })
hl.monitor({ output = "DP-2", mode = "2560x1440@59.95", position = "2400x215", scale = 1.0, transform = 1 })

local workspace_map = {
    { "1",  "DP-3" },
    { "2",  "DP-3" },
    { "3",  "DP-3" },
    { "4",  "DP-3" },
    { "5",  "DP-3" },
    { "6",  "DP-2" },
    { "7",  "DP-2" },
    { "8",  "DP-2" },
    { "9",  "DP-1" },
    { "10", "DP-1" },
    { "11", "DP-1" },
}

for _, entry in ipairs(workspace_map) do
    hl.workspace_rule({ workspace = entry[1], monitor = entry[2] })
end

{{- else if eq .chezmoi.hostname "cachyos-laptop" }}

-- Laptop configuration for the docked setup.
hl.monitor({ output = "DP-2", mode = "2560x1440@59.95", position = "0x0", scale = 1.0, transform = 1 })
hl.monitor({ output = "DP-5", mode = "3840x2160@60", position = "1440x0", scale = 1.0 })
hl.monitor({ output = "DP-3", mode = "2560x1440@59.95", position = "5280x0", scale = 1.0, transform = 3 })

-- The lid monitor service enables and disables the laptop screen.
hl.monitor({ output = "eDP-1", disabled = true })

local workspace_map = {
    { "1", "DP-5" },
    { "2", "DP-5" },
    { "3", "DP-5" },
    { "4", "DP-2" },
    { "5", "DP-2" },
    { "6", "DP-2" },
    { "7", "DP-3" },
    { "8", "DP-3" },
    { "9", "DP-3" },
}

for _, entry in ipairs(workspace_map) do
    hl.workspace_rule({ workspace = entry[1], monitor = entry[2] })
end

{{- else }}

-- Unknown machine, use auto-detection.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

{{- end }}
